{
  "name": "asciiweave",
  "version": "0.1.0",
  "private": true,
  "description": "A HackMD-like collaborative web editor for AsciiDoc",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n server,app -c blue,green \"npm:dev:server\" \"npm:dev:app\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:app": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx server/src/persistence/migrate-cli.ts apply",
    "db:status": "tsx server/src/persistence/migrate-cli.ts status",
    "deploy:staging": "npm run build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging --var GIT_COMMIT:$(git rev-parse HEAD)"
  },
  "dependencies": {
    "@asciidoctor/core": "4.0.11",
    "@codemirror/commands": "6.11.0",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@d2lang/d2": "0.1.34",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.5",
    "lib0": "0.2.117",
    "mermaid": "11.17.2",
    "ws": "8.21.3",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "y-websocket": "1.5.4",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260828.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260826.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
